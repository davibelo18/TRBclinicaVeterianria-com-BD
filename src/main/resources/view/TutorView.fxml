<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="560.0" prefWidth="780.0" spacing="12.0" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controller.TutorController">
    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
    </padding>
    <children>
        <HBox alignment="CENTER_LEFT">
            <children>
                <Label style="-fx-font-size: 22px; -fx-font-weight: bold;" text="Cadastro de Tutores" />
                <Region HBox.hgrow="ALWAYS" />
                <Button onAction="#onIrParaVeterinarios" text="Veterinários →" />
                <Button onAction="#onIrParaAnimais" text="Ir para Animais →" />
            </children>
        </HBox>
        <Separator />
        <GridPane hgap="12.0" vgap="10.0">
            <columnConstraints>
                <ColumnConstraints minWidth="75.0" />
                <ColumnConstraints hgrow="ALWAYS" />
                <ColumnConstraints minWidth="75.0" />
                <ColumnConstraints hgrow="ALWAYS" />
            </columnConstraints>
            <children>
                <Label text="Nome *" />
                <TextField fx:id="txtNome" promptText="Nome completo" GridPane.columnIndex="1" />
                <Label text="CPF" GridPane.columnIndex="2" />
                <TextField fx:id="txtCpf" promptText="000.000.000-00" GridPane.columnIndex="3" />
                <Label text="Telefone *" GridPane.rowIndex="1" />
                <TextField fx:id="txtTelefone" promptText="(00) 00000-0000" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                <Label text="E-mail" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                <TextField fx:id="txtEmail" promptText="email@exemplo.com" GridPane.columnIndex="3" GridPane.rowIndex="1" />
                <Label text="Endereço" GridPane.rowIndex="2" />
                <TextField fx:id="txtEndereco" GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="2" />
            </children>
        </GridPane>
        <HBox spacing="10.0">
            <children>
                <Button onAction="#onInserir" text="Inserir" />
                <Button onAction="#onConsultar" text="Consultar" />
                <Button onAction="#onAtualizar" text="Atualizar" />
                <Button onAction="#onExcluir" text="Excluir" />
                <Button onAction="#onLimpar" text="Limpar" />
            </children>
        </HBox>
        <TableView fx:id="tabela" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colNome" text="Nome" />
                <TableColumn fx:id="colCpf" text="CPF" />
                <TableColumn fx:id="colTelefone" text="Telefone" />
                <TableColumn fx:id="colEmail" text="E-mail" />
                <TableColumn fx:id="colEndereco" text="Endereço" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </children>
</VBox>