<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="680.0" prefWidth="780.0" spacing="12.0" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controller.VeterinarioController">
    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
    </padding>
    <children>
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <Label style="-fx-font-size: 22px; -fx-font-weight: bold;" text="Cadastro de Veterinários" />
                <Region HBox.hgrow="ALWAYS" />
                <Button onAction="#onIrParaTutores" text="← Tutores" />
                <Button onAction="#onIrParaAnimais" text="Animais" />
            </children>
        </HBox>
        <Separator />
        <GridPane hgap="12.0" vgap="10.0">
            <columnConstraints>
                <ColumnConstraints minWidth="75.0" />
                <ColumnConstraints hgrow="ALWAYS" />
                <ColumnConstraints minWidth="75.0" />
                <ColumnConstraints hgrow="ALWAYS" />
            </columnConstraints>
            <children>
                <Label text="Nome *" />
                <TextField fx:id="txtNome" GridPane.columnIndex="1" />
                <Label text="CRMV *" GridPane.columnIndex="2" />
                <TextField fx:id="txtCrmv" promptText="CRMV-PR 00000" GridPane.columnIndex="3" />
                <Label text="Telefone" GridPane.rowIndex="1" />
                <TextField fx:id="txtTelefone" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                <Label text="E-mail" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                <TextField fx:id="txtEmail" GridPane.columnIndex="3" GridPane.rowIndex="1" />
            </children>
        </GridPane>
        <HBox spacing="10.0">
            <children>
                <Button onAction="#onInserir" text="Inserir" />
                <Button onAction="#onConsultar" text="Consultar" />
                <Button onAction="#onAtualizar" text="Atualizar" />
                <Button onAction="#onExcluir" text="Excluir" />
                <Button onAction="#onLimpar" text="Limpar" />
            </children>
        </HBox>
        <TableView fx:id="tabela" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colNome" text="Nome" />
                <TableColumn fx:id="colCrmv" text="CRMV" />
                <TableColumn fx:id="colTelefone" text="Telefone" />
                <TableColumn fx:id="colEmail" text="E-mail" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
        <Label fx:id="lblAnimais" style="-fx-font-size: 15px; -fx-font-weight: bold;" text="Selecione um veterinário para ver os animais que ele acompanha" />
        <TableView fx:id="tabelaAnimais" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colAnimal" text="Animal" />
                <TableColumn fx:id="colEspecie" text="Espécie" />
                <TableColumn fx:id="colRaca" text="Raça" />
                <TableColumn fx:id="colTutor" text="Tutor" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </children>
</VBox>