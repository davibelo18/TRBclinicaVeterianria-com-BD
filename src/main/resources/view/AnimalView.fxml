<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="580.0" prefWidth="780.0" spacing="12.0" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controller.AnimalController">
    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
    </padding>
    <children>
        <HBox alignment="CENTER_LEFT">
            <children>
                <Label style="-fx-font-size: 22px; -fx-font-weight: bold;" text="Cadastro de Animais" />
                <Region HBox.hgrow="ALWAYS" />
                <Button onAction="#onIrParaVeterinarios" text="Veterinários →" />
                <Button onAction="#onIrParaTutores" text="← Ir para Tutores" />
            </children>
        </HBox>
        <Separator />
        <GridPane hgap="12.0" vgap="10.0">
            <columnConstraints>
                <ColumnConstraints minWidth="75.0" />
                <ColumnConstraints hgrow="ALWAYS" />
                <ColumnConstraints minWidth="75.0" />
                <ColumnConstraints hgrow="ALWAYS" />
            </columnConstraints>
            <children>
                <Label text="Nome *" />
                <TextField fx:id="txtNome" GridPane.columnIndex="1" />
                <Label text="Espécie *" GridPane.columnIndex="2" />
                <TextField fx:id="txtEspecie" promptText="Cachorro, gato..." GridPane.columnIndex="3" />
                <Label text="Raça" GridPane.rowIndex="1" />
                <TextField fx:id="txtRaca" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                <Label text="Nascimento" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                <DatePicker fx:id="dpNascimento" maxWidth="1.7976931348623157E308" GridPane.columnIndex="3" GridPane.rowIndex="1" />
                <Label text="Sexo" GridPane.rowIndex="2" />
                <ComboBox fx:id="cbSexo" maxWidth="1.7976931348623157E308" promptText="Selecione" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                <Label text="Tutor *" GridPane.columnIndex="2" GridPane.rowIndex="2" />
                <ComboBox fx:id="cbTutor" maxWidth="1.7976931348623157E308" promptText="Selecione o tutor" GridPane.columnIndex="3" GridPane.rowIndex="2" />
                <Label text="Veterinário" GridPane.rowIndex="3" />
                <ComboBox fx:id="cbVeterinario" maxWidth="1.7976931348623157E308" promptText="Selecione (opcional)" GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="3" />
            </children>
        </GridPane>
        <HBox spacing="10.0">
            <children>
                <Button onAction="#onInserir" text="Inserir" />
                <Button onAction="#onConsultar" text="Consultar" />
                <Button onAction="#onAtualizar" text="Atualizar" />
                <Button onAction="#onExcluir" text="Excluir" />
                <Button onAction="#onLimpar" text="Limpar" />
            </children>
        </HBox>
        <TableView fx:id="tabela" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colNome" text="Nome" />
                <TableColumn fx:id="colEspecie" text="Espécie" />
                <TableColumn fx:id="colRaca" text="Raça" />
                <TableColumn fx:id="colNascimento" text="Nascimento" />
                <TableColumn fx:id="colSexo" text="Sexo" />
                <TableColumn fx:id="colTutor" text="Tutor" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </children>
</VBox>